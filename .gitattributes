function bolt(a,b){for(let j=0;j<3;j++){const pts=[],n=14;for(let i=0;i<=n;i++){const p=a.clone().lerp(b,i/n);if(i>0&&i<n){p.x+=(Math.random()-.5)*.5;p.y+=(Math.random()-.5)*.5;p.z+=(Math.random()-.5)*.5}pts.push(p)}
 const l=new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),new THREE.LineBasicMaterial({color:j?0xffffff:0x55ccff}));scene.add(l);setTimeout(()=>{scene.remove(l);l.geometry.dispose()},130)}}
function shoot(){if(gunCd>0)return;gunCd=.5;sfx('zap');
 const dir=new THREE.Vector3();cam.getWorldDirection(dir);const o=cam.position.clone().add(dir.clone().multiplyScalar(.9));o.y-=.25;
 const cands=D?D.bots.map(b=>({p:b.g.position,bot:1,b})):thieves.map(t=>({p:t.g.position,t}));let tgt=null,best=40;
 cands.forEach(c=>{const v=new THREE.Vector3(c.p.x-cam.position.x,1.2-cam.position.y,c.p.z-cam.position.z),al=v.dot(dir);if(al<0||al>40)return;const perp=v.clone().sub(dir.clone().multiplyScalar(al)).length();if(perp<1.6&&al<best){best=al;tgt=c}});
 bolt(o,cam.position.clone().add(dir.clone().multiplyScalar(tgt?best:40)));
 if(tgt){const n=Math.hypot(dir.x,dir.z)||1,ux=dir.x/n,uz=dir.z/n;
  if(tgt.bot){const b=tgt.b;if(b.carry){place(A.mine,b.carry);b.carry=null}b.bt=0;b.stun=2;b.vx=ux*60;b.vz=uz*60;toast('⚡ ZAPPED!')}
  else{const t=tgt.t;if(t.has&&!t.ped.item){place(t.ped,t.has);toast('⚡ Zapped! Verity recovered')}else toast('⚡ ZAPPED!');t.has=null;t.st='stun';t.t=2;t.vx=ux*60;t.vz=uz*60}
  sun.intensity=2}}
function mkThief(){const occ=mine.filter(p=>p.item);if(!occ.length)return;const ped=occ[Math.floor(Math.random()*occ.length)];
const g=new THREE.Group();
const b=new THREE.Mesh(new THREE.BoxGeometry(.8,1.2,.5),new THREE.MeshStandardMaterial({color:0xe03030}));b.position.y=1;g.add(b);
const h=new THREE.Mesh(new THREE.SphereGeometry(.32,32,32),new THREE.MeshStandardMaterial({color:0xf2c9a0}));h.position.y=1.9;g.add(h);
const k=new THREE.Mesh(new THREE.BoxGeometry(.7,.2,.1),new THREE.MeshStandardMaterial({color:0x111111}));k.position.set(0,1.95,-.3);g.add(k);
const side=Math.random()<.5?-1:1;g.position.set(side*41,0,10);scene.add(g);
thieves.push({g,ped,st:'walk',t:0,vx:0,has:null,side,wp:[[side*41,10],[0,14],[0,22],[ped.x,ped.z-1.8]]})}
function setFlee(t){const p=t.g.position;t.wp=[];if(p.z>19)t.wp.push([0,22]);t.wp.push([0,14],[t.side*41,10]);t.st='flee'}
function follow(t,dt,sp){const w=t.wp[0];if(!w)return true;const g=t.g,dx=w[0]-g.position.x,dz=w[1]-g.position.z,d=Math.hypot(dx,dz);
 if(d<.4){t.wp.shift();return !t.wp.length}g.position.x+=dx/d*sp*dt;g.position.z+=dz/d*sp*dt;g.rotation.y=Math.atan2(dx,dz)+Math.PI;g.position.y=Math.abs(Math.sin(performance.now()/120))*.15;return false}
function collide(p){colliders.forEach(c=>{const nx=Math.max(c.x-c.hw,Math.min(p.x,c.x+c.hw)),nz=Math.max(c.z-c.hd,Math.min(p.z,c.z+c.hd));const dx=p.x-nx,dz=p.z-nz,d=Math.hypot(dx,dz);if(d<.6){if(d>1e-4){p.x=nx+dx/d*.6;p.z=nz+dz/d*.6}else p.x+=.6}})}

function frame(dt){
if(keys.ArrowLeft)yaw+=dt*2;if(keys.ArrowRight)yaw-=dt*2;if(keys.ArrowUp)pitch=Math.min(1.4,pitch+dt*1.5);if(keys.ArrowDown)pitch=Math.max(-1.4,pitch-dt*1.5);
cam.rotation.set(pitch,yaw,0);
const f=(keys.KeyW?1:0)-(keys.KeyS?1:0),s=(keys.KeyD?1:0)-(keys.KeyA?1:0),sp=(keys.ShiftLeft?15:9)*dt;
const fx=-Math.sin(yaw),fz=-Math.cos(yaw);
cam.position.x+=(fx*f+Math.cos(yaw)*s)*sp;cam.position.z+=(fz*f-Math.sin(yaw)*s)*sp;
if(!D){cam.position.x=Math.max(-150,Math.min(150,cam.position.x));cam.position.z=Math.max(-120,Math.min(120,cam.position.z))}else{cam.position.x=Math.max(-44,Math.min(44,cam.position.x));cam.position.z=Math.max(AZ-54,Math.min(AZ+54,cam.position.z))}collide(cam.position);
if(keys.Space&&cam.position.y<=1.71)vy=7;vy-=20*dt;cam.position.y=Math.max(1.7,cam.position.y+vy*dt);if(cam.position.y===1.7)vy=0;
sun.position.set(cam.position.x+30,cam.position.y+60,cam.position.z+20);sun.target.position.copy(cam.position);
if(gunCd>0)gunCd-=dt;
if(D){duelFrame(dt,fx,fz);return}
// belt
bt.offset.x-=dt*.867;
spawnT-=dt;if(spawnT<=0){spawnT=LK.t>0?1.3:2;const lord=Math.random()*100<LORD[4]*luckMult(),og2=!lord&&Math.random()*100<OG2[4]*luckMult();let d=lord?LORD:og2?OG2:rnd();if(EV.m&&Math.random()<.35)d=mutate(d,EV.m);const g=mkItem(d);g.position.set(-43,.7,0);belts.push({g,d});if(og2)toast('✨ THE VERITIES OF THE VERITY spawned on the belt!!');if(lord)toast('👑 LORD VERITY spawned on the belt!!')}
for(let i=belts.length-1;i>=0;i--){const b=belts[i];b.g.position.x+=dt*2.6;b.g.userData.m.rotation.y+=dt*2;if(b.g.position.x>44){scene.remove(b.g);belts.splice(i,1)}}
// income
let inc=0;mine.forEach(p=>{if(p.item)inc+=p.item.userData.d[2]});coins+=inc*dt;
$('coins').textContent='$'+fmt(Math.floor(coins));$('inc').textContent='Income: +'+fmt(inc)+'/s'+(carry?'  |  Carrying: '+carry[0]+' — run to your castle!':'');
// interact
let prompt='',near=null,nd=4.2;
belts.forEach(b=>{const d=Math.hypot(b.g.position.x-cam.position.x,b.g.position.z-cam.position.z);if(d<nd){nd=d;near=b}});
const freeMine=mine.find(p=>!p.item);
if(near){prompt=freeMine?`[E] Buy ${near.d[0]} — $${fmt(near.d[1])} (${near.d[4]}% chance)`:'Your castle is full!';
 if(ePress&&freeMine&&!carry){if(coins>=near.d[1]){coins-=near.d[1];sfx('buy');place(freeMine,near.d);scene.remove(near.g);belts.splice(belts.indexOf(near),1)}else toast('Not enough money!')}}
let rp=null;if(!near&&!carry)rp=rival.find(p=>p.item&&Math.hypot(p.x-cam.position.x,p.z-cam.position.z)<3);
if(rp){prompt=`Hold [E] to STEAL ${rp.item.userData.d[0]} (${Math.floor(stealT/2.5*100)}%)`;
 if(keys.KeyE){stealT+=dt;if(stealT>=2.5){carry=rp.item.userData.d;scene.remove(rp.item);rp.item=null;rp.t=12;stealT=0;toast('Stolen! Run it back to your castle!')}}else stealT=0}else stealT=0;
if(carry&&Math.abs(cam.position.x)<14&&cam.position.z>20&&freeMine){place(freeMine,carry);toast(carry[0]+' secured!');carry=null}
if(!near&&!rp&&Math.hypot(cam.position.x-DM.x,cam.position.z-DM.z)<4.5){prompt='[E] ⚔ DUEL a bot — first to 3 wins';if(ePress){if(carry)toast('Drop off your stolen verity first!');else openDuelSel()}}
if(!near&&!rp&&Math.hypot(cam.position.x-FM.x,cam.position.z-FM.z)<4.5){prompt='[E] 🔮 FUSE MACHINE — merge 4 verities';if(ePress)openFuse()}
$('prompt').textContent=prompt;ePress=false;
rival.forEach(p=>{if(!p.item){p.t-=dt;if(p.t<=0)place(p,rnd())}});
peds.forEach(p=>{if(p.item)p.item.userData.m.rotation.y+=dt});
// thieves
thiefT-=dt;if(thiefT<=0){thiefT=7+Math.random()*5;if(LOCK.st!=='on')mkThief()}
let warn=null;
for(let i=thieves.length-1;i>=0;i--){const t=thieves[i],g=t.g;
 if(t.st==='walk'&&LOCK.st==='on'&&t.g.position.z<19.5)setFlee(t);
 else if(t.st==='walk'){if(follow(t,dt,4.4)){if(t.ped.item){t.st='steal';t.t=0}else setFlee(t)}}
 else if(t.st==='steal'&&!t.ped.item)setFlee(t);
 else if(t.st==='steal'){t.t+=dt;g.rotation.y=Math.PI;g.position.y=0;g.rotation.z=Math.sin(t.t*12)*.05;
  if(!warn||t.t>warn.t)warn=t;
  if(t.t>=3.5){t.has=t.ped.item.userData.d;scene.remove(t.ped.item);t.ped.item=null;g.rotation.z=0;setFlee(t);toast('A thief stole '+t.has[0]+'! Hit them!')}}
 else if(t.st==='stun'){t.t-=dt;g.position.x+=t.vx*dt;g.position.z+=(t.vz||0)*dt;t.vx*=.9;t.vz=(t.vz||0)*.9;g.rotation.z=Math.sin(performance.now()/60)*.2;if(t.t<=0){g.rotation.z=0;setFlee(t)}}
 else if(t.st==='flee'){if(follow(t,dt,5.6)){scene.remove(g);thieves.splice(i,1)}}}
// bat
if(swing>0){swing-=dt;const k=1-swing/.3;bat.rotation.set(.2-Math.sin(k*Math.PI)*1.4,Math.sin(k*Math.PI)*.8,-.4);
 if(!hitDone&&k>.4){hitDone=true;let hit=false;
  thieves.forEach(t=>{const dx=t.g.position.x-cam.position.x,dz=t.g.position.z-cam.position.z,d=Math.hypot(dx,dz);
   if(d<3.6&&(dx*fx+dz*fz)/d>.2){hit=true;
    if(t.has&&!t.ped.item){place(t.ped,t.has);toast('You got '+t.has[0]+' back!')}else if(t.st==='steal'){toast('Theft cancelled! 🏏')}
    t.has=null;t.st='stun';t.t=1.3;t.vx=(dx>0?1:-1)*9}})
  if(hit)sun.intensity=1.4}}
else bat.rotation.set(.2,0,-.4);
sun.intensity+=(.8-sun.intensity)*.2;
if(warn){$('warn').style.display='block';$('wtxt').textContent='⚠ THIEF STEALING '+warn.ped.item.userData.d[0].toUpperCase()+'! HIT THEM WITH THE BAT!';$('bar').firstChild.style.width=Math.min(100,warn.t/3.5*100)+'%'}else $('warn').style.display='none';
}
let last=performance.now();
let pr=1.25,acc=0,cnt=0,fn=0;
(function loop(){requestAnimationFrame(loop);const n=performance.now(),raw=(n-last)/1000,dt=Math.min(.05,raw);last=n;acc+=raw;cnt++;
if(acc>2){const fps=cnt/acc;acc=0;cnt=0;if(started&&fps<42&&pr>1){pr=Math.max(1,pr-.25);R.setPixelRatio(pr);R.setSize(innerWidth,innerHeight)}}
if(started){luckTick(dt);lockTick(dt);pendTick();if(!D)evTick(dt);envTick(dt);frame(dt)}faceAll();machTick();dressTick();R.shadowMap.needsUpdate=(++fn%2===0);R.render(scene,cam)})();
</script></body></html>
